{
  "name": "docunex",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=24.11"
  },
  "scripts": {
    "dev": "pnpm --filter @docunex/shared build && pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @docunex/api test:e2e",
    "typecheck": "pnpm --filter @docunex/shared build && pnpm -r typecheck",
    "lint": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose up -d --wait db",
    "db:down": "docker compose down",
    "user:create": "pnpm --filter @docunex/api user:create"
  },
  "devDependencies": {
    "oxlint": "^1.81.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3"
  }
}
