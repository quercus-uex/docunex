{
  "name": "@docunex/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch --preserveWatchOutput",
    "start": "node dist/main.js",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.config.e2e.ts",
    "typecheck": "tsc --noEmit",
    "typeorm": "typeorm -d dist/database/cli-data-source.js",
    "migration:generate": "nest build && typeorm -d dist/database/cli-data-source.js migration:generate",
    "migration:run": "nest build && typeorm -d dist/database/cli-data-source.js migration:run",
    "migration:revert": "nest build && typeorm -d dist/database/cli-data-source.js migration:revert",
    "user:create": "nest build && node dist/cli/create-user.js"
  },
  "dependencies": {
    "@docunex/shared": "workspace:*",
    "@nestjs/common": "^12.1.1",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.1",
    "@nestjs/jwt": "^12.0.2",
    "@nestjs/platform-express": "^12.1.1",
    "@nestjs/typeorm": "^12.0.2",
    "argon2": "^0.45.1",
    "cookie-parser": "^1.4.7",
    "pg": "^8.23.0",
    "pg-boss": "^12.35.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^1.1.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.8",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.1.1",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/node": "^24.13.3",
    "@types/supertest": "^7.0.0",
    "supertest": "^7.3.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.2"
  }
}
