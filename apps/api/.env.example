# Copia este fichero a .env y ajusta los valores.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://docunex:docunex@localhost:5432/docunex
# Mínimo 32 caracteres. Genera uno con: node -e "console.log(crypto.randomBytes(32).toString('base64url'))"
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
SESSION_TTL_DAYS=7
# Pon true si la aplicación se sirve por HTTPS.
COOKIE_SECURE=false
STORAGE_DIR=./data/storage
# Página de convocatorias PCI de la que se leen las plazas (por defecto, la de la UEx).
# UEX_PCI_URL=https://rrhhinvestigacion.unex.es/funciones/concursos/convocatorias-pci/
